rules_version = '2';

// Escape the Matrix — Firestore security rules.
// Each signed-in user owns exactly one document, users/{uid} = { doc, updatedAt, email }.
// Only that user may read or write it; every other path is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The app writes the whole envelope every time; keep it to the known shape.
    function isEnvelope() {
      let data = request.resource.data;
      return data.keys().hasOnly(['doc', 'updatedAt', 'email'])
        && data.doc is map
        && data.updatedAt is string;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isEnvelope();
    }

    // A voucher code is itself the secret: the Stripe webhook makes it (as admin) and emails it; it can be
    // fetched only by someone who already knows it (listing is denied), and the only change a customer
    // may make is claiming an unclaimed one.
    match /vouchers/{code} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.redeemedBy == null
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt']);
    }

    // What the account may use. Pro comes from a voucher this very account claimed — nothing else the
    // app can write makes someone Pro. (The Stripe webhook writes here as admin.)
    match /billing/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['plan', 'voucher', 'period', 'currentPeriodEnd', 'updatedAt'])
        && request.resource.data.plan == 'pro'
        && request.resource.data.voucher is string
        && get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher)).data.redeemedBy == request.auth.uid
        // The paid period is the one written on the voucher — an account cannot grant itself more.
        && request.resource.data.currentPeriodEnd == get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher)).data.get('until', null);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
