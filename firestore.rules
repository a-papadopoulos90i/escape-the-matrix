rules_version = '2';

// Levelix — Firestore security rules.
// Each signed-in user owns their account: users/{uid} = { format: 2, settings, updatedAt, email } and one
// document per month of tasks, users/{uid}/months/{YYYY-MM} = { tasks, updatedAt }. Only that user may read
// or write them; every other path is denied. (The old single-document shape { doc, updatedAt, email } is
// still accepted while browsers holding an older copy of the app catch up.)
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The root of an account: the current shape, or the old whole-document envelope.
    function isRoot() {
      let data = request.resource.data;
      return data.updatedAt is string
        && ((data.keys().hasOnly(['format', 'settings', 'updatedAt', 'email']) && data.format == 2 && data.settings is map)
          || (data.keys().hasOnly(['doc', 'updatedAt', 'email']) && data.doc is map));
    }

    function isMonth(month) {
      let data = request.resource.data;
      return month.matches('^([0-9]{4}-[0-9]{2}|undated)$')
        && data.keys().hasOnly(['tasks', 'updatedAt'])
        && data.tasks is list
        && data.updatedAt is string;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isRoot();

      match /months/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isMonth(month);
      }
    }

    // A voucher code is itself the secret: the Stripe webhook makes it (as admin) and emails it; it can be
    // fetched only by someone who already knows it (listing is denied), and the only change a customer
    // may make is claiming an unclaimed one.
    match /vouchers/{code} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.redeemedBy == null
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt']);
    }

    // What the account may use. Pro comes from a voucher this very account claimed — nothing else the
    // app can write makes someone Pro. (The Stripe webhook writes here as admin.)
    match /billing/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['plan', 'voucher', 'period', 'currentPeriodEnd', 'updatedAt'])
        && request.resource.data.plan == 'pro'
        && request.resource.data.voucher is string
        && get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher)).data.redeemedBy == request.auth.uid
        // The paid period is the one written on the voucher — an account cannot grant itself more.
        && request.resource.data.currentPeriodEnd == get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher)).data.get('until', null);
      allow delete: if false;
    }

    // The owners list (the Reminders bridge on the owner's Mac): readable only by someone on it.
    match /config/owners {
      allow get: if request.auth != null && request.auth.uid in resource.data.uids;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
