rules_version = '2';

// Escape the Matrix — Firestore security rules.
// Each signed-in user owns exactly one document, users/{uid} = { doc, updatedAt, email }.
// Only that user may read or write it; every other path is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The app writes the whole envelope every time; keep it to the known shape.
    function isEnvelope() {
      let data = request.resource.data;
      return data.keys().hasOnly(['doc', 'updatedAt', 'email'])
        && data.doc is map
        && data.updatedAt is string;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isEnvelope();
    }

    // Who may hand out vouchers: config/owners = { uids: [...] }, written from the console only.
    function ownerUids() {
      return get(/databases/$(database)/documents/config/owners).data.uids;
    }

    function isVoucherOwner() {
      return request.auth != null && request.auth.uid in ownerUids();
    }

    // A voucher code is itself the secret: it can be fetched only by someone who already knows the
    // code (listing is denied), and the only change a customer may make is claiming an unclaimed one.
    match /vouchers/{code} {
      allow get: if request.auth != null;
      allow list: if isVoucherOwner();
      allow create, delete: if isVoucherOwner();
      allow update: if request.auth != null
        && resource.data.redeemedBy == null
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt']);
    }

    // What the account may use. Pro comes from a voucher this very account claimed — nothing else the
    // app can write makes someone Pro. (The Stripe webhook, when it runs, writes here as admin.)
    match /billing/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['plan', 'voucher', 'period', 'currentPeriodEnd', 'updatedAt'])
        && request.resource.data.plan == 'pro'
        && request.resource.data.voucher is string
        && get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher)).data.redeemedBy == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
